# Anara — variáveis de ambiente. Copie para `.env` e preencha.
#
# NUNCA versione o `.env` com valores reais: o `.gitignore` já o exclui, e este arquivo de
# exemplo existe justamente para que ninguém precise inventar os nomes das variáveis nem
# copiar um segredo de outro lugar. Os valores abaixo são EXEMPLOS e não funcionam em
# produção: a aplicação recusa `ANARA_SECRET_KEY` com cara de exemplo.

# ---------------------------------------------------------------------------
# OBRIGATÓRIAS em produção
# ---------------------------------------------------------------------------
# `producao` liga o `Secure` no cookie (exige HTTPS), torna a SECRET_KEY obrigatória e
# desliga o backend de e-mail de desenvolvimento.
ANARA_ENV=producao

# Assina o cookie de sessão. Sem ela e com ANARA_ENV=producao, o processo NÃO SOBE — de
# propósito: um segredo default conhecido é o mesmo que não ter assinatura.
# Gere a sua com:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo de 32 caracteres; valores de exemplo e repetitivos são recusados.
ANARA_SECRET_KEY=cole-aqui-a-chave-gerada-com-o-comando-acima

# Endereço público do sistema, com https://. É a base dos links de redefinição de senha e
# primeiro acesso que vão por e-mail.
ANARA_BASE_URL=https://cotacoes.exemplo.com.br

# Banco de dados. No Railway, referencie a variável do serviço PostgreSQL:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
# `postgres://` e `postgresql://` são aceitos e normalizados para o driver psycopg 3.
DATABASE_URL=postgresql://usuario:senha@host:5432/anara

# ---------------------------------------------------------------------------
# E-mail (recuperação de senha e primeiro acesso). Sem SMTP em produção, "Esqueci minha
# senha" responde a frase genérica e NÃO envia nada — o log avisa na subida.
# ---------------------------------------------------------------------------
ANARA_MAIL_HOST=smtp.exemplo.com.br
ANARA_MAIL_PORT=587
ANARA_MAIL_USER=cotacoes@exemplo.com.br
ANARA_MAIL_PASSWORD=senha-do-smtp-aqui
ANARA_MAIL_FROM=Anara Cotações <cotacoes@exemplo.com.br>
# 1 = STARTTLS (padrão, porta 587); 0 = sem TLS (só em rede interna)
ANARA_MAIL_TLS=1

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# Porta HTTP. O Railway injeta PORT sozinho; local, o padrão é 8420.
# PORT=8420

# Aponta o sistema INTEIRO para outro banco — aplicação, scripts e migrations — e tem
# precedência sobre DATABASE_URL. Use para testar contra uma cópia sem tocar no histórico.
# Vazia = DATABASE_URL; sem as duas = data/anara.db (SQLite, dentro do repositório).
# ANARA_DB_URL=sqlite:////caminho/para/uma/copia.db

# Senha do primeiro OWNER, lida por `scripts/criar_usuario.py`. Defina só na hora de criar o
# usuário e remova em seguida — não deixe senha em arquivo.
# ANARA_SENHA_BOOTSTRAP=

# Só para a suíte de testes: `memoria` guarda os e-mails em memória em vez de enviar.
# ANARA_MAIL_BACKEND=memoria
# Só para a suíte de testes: roda os testes de banco contra este PostgreSQL (o esquema é
# recriado do zero a cada execução — NUNCA aponte para produção).
# ANARA_TEST_DB_URL=postgresql://anara@127.0.0.1:55432/anara_teste
