# Anara — variáveis de ambiente. Copie para `.env` e preencha.
#
# NUNCA versione o `.env` com valores reais: o `.gitignore` já o exclui, e este arquivo de
# exemplo existe justamente para que ninguém precise inventar os nomes das variáveis nem
# copiar um segredo de outro lugar.

# ---------------------------------------------------------------------------
# OBRIGATÓRIA em produção
# ---------------------------------------------------------------------------
# Assina o cookie de sessão. Sem ela e com ANARA_ENV=producao, o processo NÃO SOBE — de
# propósito: um segredo default conhecido é o mesmo que não ter assinatura, e qualquer
# pessoa poderia forjar o cookie de um OWNER.
#
# Gere a sua com:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo de 32 caracteres.
ANARA_SECRET_KEY=cole-aqui-a-chave-gerada-com-o-comando-acima

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# `producao` liga o `Secure` no cookie (exige HTTPS) e torna a SECRET_KEY obrigatória.
# Em desenvolvimento, sem SECRET_KEY, uma chave aleatória é gerada a cada processo — segura,
# mas instável: reiniciar derruba as sessões abertas.
ANARA_ENV=desenvolvimento

# Aponta o sistema INTEIRO para outro banco — aplicação, scripts e migrations.
# Use para testar contra uma cópia sem tocar no histórico. Vazia = ~/Anara-Cotacao/data/anara.db
# ANARA_DB_URL=sqlite:////caminho/para/uma/copia.db

# Senha do primeiro OWNER, lida por `scripts/criar_usuario.py`. Defina só na hora de criar o
# usuário e remova em seguida — não deixe senha em arquivo.
# ANARA_SENHA_BOOTSTRAP=
